<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Girlette</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/home.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <section class="hero">
    <img
      src="/image/hero.jpg"
      onerror="this.src='https://images.unsplash.com/photo-1483985988355-763728e1935b?w=1400&q=80'"
      alt="Hero Collection"
      class="hero-img">
    <div class="hero-caption">
      <h1>Elevate Your Style<br>Timeless Fashion, Sustainable<br>Choices</h1>
      <a href="/products" class="btn-shop-now">Shop Now</a>
    </div>
  </section>

  <section class="bestseller-section">
    <div class="container-fluid px-4 px-lg-5">
      <h2 class="section-title">Best Seller</h2>
      <div class="row g-3">
        <% products.forEach(product => { %>
        <div class="col-6 col-md-3">
          <a href="/product/<%= product.id %>" class="product-card">
            <div class="product-img-wrapper">
              <img
                src="<%= product.image %>"
                onerror="this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=600&q=80'"
                alt="<%= product.name %>">
            </div>
            <div class="product-info">
              <p class="product-name"><%= product.name %></p>
              <p class="product-price">฿<%= product.price %></p>
            </div>
          </a>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="about-inner">
      <h2>The Art of Fewer, Better Choices</h2>
      <p>
        Opting for quality over quantity means selecting timeless, durable, and responsibly made items.
        This approach simplifies our lives and fosters a deeper appreciation for our belongings,
        emphasising longevity and responsible production within a more sustainable and mindful lifestyle.
      </p>
    </div>
  </section>

  <section class="editorial-section">
    <div class="container-fluid px-4 px-lg-5">
      <div id="editorialCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
        <div class="carousel-inner">

          <!-- Slide 1: New Arrival, Top, Bottom -->
          <div class="carousel-item active">
            <div class="row g-2">
              <div class="col-4">
                <a href="/products?sort=new" class="editorial-item">
                  <img src="/images/cat-new.jpg"
                       onerror="this.src='https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=600&q=80'"
                       alt="New Arrival">
                  <span class="editorial-label">New Arrival</span>
                </a>
              </div>
              <div class="col-4">
                <a href="/category/top" class="editorial-item">
                  <img src="/images/cat-top.jpg"
                       onerror="this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=600&q=80'"
                       alt="Top">
                  <span class="editorial-label">Top</span>
                </a>
              </div>
              <div class="col-4">
                <a href="/category/bottom" class="editorial-item">
                  <img src="/images/cat-bottom.jpg"
                       onerror="this.src='https://images.unsplash.com/photo-1583496661160-fb5886a0aaaa?w=600&q=80'"
                       alt="Bottom">
                  <span class="editorial-label">Bottom</span>
                </a>
              </div>
            </div>
          </div>

          <div class="carousel-item">
            <div class="row g-2">
              <div class="col-4">
                <a href="/category/outerwear" class="editorial-item">
                  <img src="/images/cat-outerwear.jpg"
                       onerror="this.src='https://images.unsplash.com/photo-1576871337622-98d48d1cf531?w=600&q=80'"
                       alt="Outerwear">
                  <span class="editorial-label">Outerwear</span>
                </a>
              </div>
              <div class="col-4">
                <a href="/category/dress" class="editorial-item">
                  <img src="/images/cat-dress.jpg"
                       onerror="this.src='https://images.unsplash.com/photo-1515372039744-b8f02a3ae446?w=600&q=80'"
                       alt="Dress">
                  <span class="editorial-label">Dress</span>
                </a>
              </div>
              <div class="col-4">
                <a href="/category/pajama" class="editorial-item">
                  <img src="/images/cat-pajama.jpg"
                       onerror="this.src='https://images.unsplash.com/photo-1585487000160-6ebcfceb0d03?w=600&q=80'"
                       alt="Pajama">
                  <span class="editorial-label">Pajama</span>
                </a>
              </div>
            </div>
          </div>

        </div>

        <div class="carousel-indicators editorial-indicators">
          <button type="button" data-bs-target="#editorialCarousel" data-bs-slide-to="0" class="active"></button>
          <button type="button" data-bs-target="#editorialCarousel" data-bs-slide-to="1"></button>
        </div>
      </div>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/navbar.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>

<!-- หลือใส่ app.js อย่าลืมนะ -->