<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Girlette</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <section class="hero">
    <img
      src="/image/hero.jpg"
      onerror="this.src='https://images.unsplash.com/photo-1483985988355-763728e1935b?w=1400&q=80'"
      alt="Hero Collection"
      class="hero-img">
    <div class="hero-caption">
      <h1>Elevate Your Style<br>Timeless Fashion, Sustainable<br>Choices</h1>
      <a href="/products" class="btn-shop-now">Shop Now</a>
    </div>
  </section>

  <section class="bestseller-section">
    <div class="container-fluid px-4 px-lg-5">
      <h2 class="section-title fade-up">Best Seller</h2>
      <div class="row g-3">
        <% products.forEach(product => { %>
        <div class="col-6 col-md-3 fade-up">
          <a href="/product/<%= product.id %>" class="product-card">
            <div class="product-img-wrapper">
              <img
                src="<%= product.image %>"
                onerror="this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=600&q=80'"
                alt="<%= product.name %>">
            </div>
            <div class="product-info">
              <p class="product-name"><%= product.name %></p>
              <p class="product-price">฿<%= product.price %></p>
            </div>
          </a>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="about-section fade-up">
    <div class="about-inner">
      <h2>The Art of Fewer, Better Choices</h2>
      <p>
        Opting for quality over quantity means selecting timeless, durable, and responsibly made items.
        This approach simplifies our lives and fosters a deeper appreciation for our belongings,
        emphasising longevity and responsible production within a more sustainable and mindful lifestyle.
      </p>
    </div>
  </section>

  <section class="editorial-section fade-up">
    <div class="container-fluid px-4 px-lg-5">
      <div id="editorialCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
        <div class="carousel-inner">

          <%
            const allItems = [
              { 
                name: 'New Arrival', 
                slug: null, 
                href: '/products?sort=new', 
                image: newestImage
              },
              ...categories.map(cat => ({ 
                name: cat.name, 
                slug: cat.slug, 
                href: `/category/${cat.slug}`,
                image: cat.image   
              }))
            ];

            const chunks = [];
            for (let i = 0; i < allItems.length; i += 3) {
              chunks.push(allItems.slice(i, i + 3));
            }
          %>

          <% chunks.forEach((chunk, chunkIndex) => { %>
            <div class="carousel-item <%= chunkIndex === 0 ? 'active' : '' %>">
              <div class="row g-2">
                <% chunk.forEach(item => { %>
                  <div class="col-4">
                    <a href="<%= item.href %>" class="editorial-item">
                     <img src="<%= item.image || 'https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=600&q=80' %>"
                      onerror="this.src='https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=600&q=80'"
                      alt="<%= item.name %>">
                      <span class="editorial-label"><%= item.name %></span>
                    </a>
                  </div>
                <% }) %>
              </div>
            </div>
          <% }) %>

        </div>

        <div class="carousel-indicators editorial-indicators">
          <% chunks.forEach((_, i) => { %>
            <button type="button" data-bs-target="#editorialCarousel"
                    data-bs-slide-to="<%= i %>"
                    class="<%= i === 0 ? 'active' : '' %>"></button>
          <% }) %>
        </div>

      </div>
    </div>

    
  </section>

  <button class="back-to-top" id="backToTop">↑</button>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/navbar.js"></script>
  <script src="/js/home.js"></script>
</body>
</html>

<!-- หลือใส่ app.js อย่าลืมนะ -->