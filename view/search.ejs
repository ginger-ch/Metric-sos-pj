<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Search: "<%= query %>" — Girlette</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/search.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <main class="search-main">
    <div class="container-fluid px-4 px-lg-5">

      <div class="search-header">
        <h1 class="search-title">"<%= query %>"</h1>
        <p class="search-count">
          <% if (products.length === 0) { %>
            No results found for "<%= query %>"
          <% } else { %>
            <%= totalResults %> result<%= totalResults !== 1 ? 's' : '' %> found for "<%= query %>"
          <% } %>
        </p>
      </div>

      <% if (products.length === 0) { %>
        <div class="search-empty">
          <p class="search-empty-icon">✿</p>
          <p class="search-empty-text">We couldn't find anything matching your search.</p>
          <a href="/products" class="search-browse-btn">Browse all products</a>
        </div>

      <% } else { %>
        <div class="row g-3">
          <% products.forEach(product => { %>
          <div class="col-12 col-md-3 product-item">
            <a href="/product/<%= product.id %>" class="product-card">
              <div class="product-img-wrapper">
                <img
                  src="<%= product.image %>"
                  onerror="this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=600&q=80'"
                  alt="<%= product.name %>">
              </div>
              <div class="product-info">
                <p class="product-name"><%= product.name %></p>
                <p class="product-price">฿<%= product.price %></p>
              </div>
            </a>
          </div>
          <% }) %>
        </div>

        <% if (totalPages > 1) { %>
        <div class="search-pagination">
          <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= i %>"
               class="page-btn <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
          <% } %>
        </div>
        <% } %>
      <% } %>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/navbar.js"></script>
</body>
</html>