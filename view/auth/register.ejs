<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Account</title>
  <link rel="stylesheet" href="/css/register.css" />
</head>
<body>
  <div class="card">

    <div class="logo">
      <img src="/image/logo.png" alt="Logo" />
    </div>

    <div class="form-area">
      <h1>Create account</h1>
      <% if (typeof errors !== 'undefined' && errors.general) { %>
      <p class="error-msg"><%= errors.general %></p>
     <% } %>

      <form action="/register" method="POST" novalidate>

        <div class="form-group">
          <label for="username">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            placeholder="Your username"
            value="<%= typeof formData !== 'undefined' ? formData.username : '' %>"
            required
          />
          <% if (typeof errors !== 'undefined' && errors.username) { %>
            <p class="error-msg"><%= errors.username %></p>
          <% } %>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="Your email"
            value="<%= typeof formData !== 'undefined' ? formData.email : '' %>"
            required
          />
          <% if (typeof errors !== 'undefined' && errors.email) { %>
            <p class="error-msg"><%= errors.email %></p>
          <% } %>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="password-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Your password"
              required
            />
            <button type="button" class="toggle-password" id="toggleBtn">
              <svg id="eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                <line x1="1" y1="1" x2="23" y2="23"/>
              </svg>
            </button>
          </div>
          <% if (typeof errors !== 'undefined' && errors.password) { %>
            <p class="error-msg"><%= errors.password %></p>
          <% } %>
        </div>

        <div class="checkbox-group">
          <input type="checkbox" id="terms" name="terms" checked />
          <div class="custom-checkbox" id="customCheckbox">
            <svg viewBox="0 0 11 9">
              <polyline points="1,4.5 4,8 10,1"/>
            </svg>
          </div>
          <label for="terms">I accept the terms and privacy policy</label>
        </div>

        <button type="submit" class="btn-signup">Sign up</button>

      </form>

      <p class="login-link">
        Already have an account? <a href="/login">Log in</a>
      </p>

    </div>

  </div>

  <script src="/js/register.js"></script>
</body>
</html>