<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>All Products — Girlette</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/all-products.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <main class="products-main">
    <div class="container-fluid px-4 px-lg-5">

      <!-- Page Title -->
      <h1 class="products-title">All products</h1>

      <!-- Product Grid -->
      <div class="row g-3" id="productGrid">
        <% products.forEach(product => { %>
        <div class="col-6 col-md-3 product-item">
          <a href="/product/<%= product.id %>" class="product-card">
            <div class="product-img-wrapper">
              <img
                src="<%= product.image %>"
                onerror="this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=600&q=80'"
                alt="<%= product.name %>">
            </div>
            <div class="product-info">
              <p class="product-name"><%= product.name %></p>
              <p class="product-price">฿<%= product.price %></p>
            </div>
          </a>
        </div>
        <% }) %>
      </div>

      <!-- Pagination -->
      <div class="pagination-wrapper" id="paginationWrapper">
        <!-- rendered by JS -->
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/navbar.js"></script>
  <!-- pass total pages from server to JS -->
  <script>
    const TOTAL_PAGES = <%= totalPages %>;
    const CURRENT_PAGE = <%= currentPage %>;
  </script>
  <script src="/js/all-products.js"></script>
</body>
</html>
