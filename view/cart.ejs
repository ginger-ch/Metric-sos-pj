<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Shopping Cart — Girlette</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/cart.css"> 
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <main class="cart-main"> <div class="container-fluid px-4 px-lg-5">

      <h1 class="cart-title">Your Shopping Cart</h1> 

      <% if (items.length === 0) { %>
        <div class="cart-empty"> <p>Your cart is empty.</p>
          <a href="/products" class="btn-continue">Continue Shopping</a>
        </div>

      <% } else { %>

        <table class="cart-table d-none d-md-table"> <thead>
            <tr>
              <th>Product</th>
              <th>Description</th>
              <th>Quantity</th>
              <th>Price</th>
              <th>Total</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
            <tr>
              <td class="td-product">
                <img class="cart-product-img"
                     src="<%= item.image %>"
                     onerror="this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=300&q=80'"
                     alt="<%= item.name %>">
              </td>
              <td class="td-desc">
                <p class="cart-product-name"><%= item.name %></p>
                <p class="cart-product-attr">
                  <% if (item.color) { %>Color: <%= item.color %><br><% } %>
                  <% if (item.size) { %>Size: <%= item.size %><% } %>
                </p>
              </td>
              <td class="td-qty">
                <div class="qty-control">
                  <form method="POST" action="/cart/update" class="d-inline">
                    <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
                    <input type="hidden" name="quantity" value="<%= item.quantity - 1 %>">
                    <button class="qty-btn" type="submit">−</button>
                  </form>
                  <span class="qty-value"><%= item.quantity %></span>
                  <form method="POST" action="/cart/update" class="d-inline">
                    <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
                    <input type="hidden" name="quantity" value="<%= item.quantity + 1 %>">
                    <button class="qty-btn" type="submit">+</button>
                  </form>
                </div>
              </td>
              <td class="td-price">฿<%= Number(item.price).toLocaleString() %></td>
              <td class="td-total">฿<%= (Number(item.price) * item.quantity).toLocaleString() %></td>
              <td class="td-delete">
                <form method="POST" action="/cart/remove">
                  <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
                  <button class="btn-delete" type="submit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <polyline points="3 6 5 6 21 6"/>
                      <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                      <path d="M10 11v6M14 11v6"/>
                      <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                    </svg>
                  </button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>

        <div class="cart-cards d-md-none"> <% items.forEach(item => { %>
          <div class="cart-card"> <img class="cart-card-img"
                 src="<%= item.image %>"
                 onerror="this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?w=300&q=80'"
                 alt="<%= item.name %>">
            <div class="cart-card-body">
              <p class="cart-card-label">Description</p>
              <p class="cart-card-name"><%= item.name %></p>
              <p class="cart-card-attr">
                <% if (item.color) { %>Color: <%= item.color %><br><% } %>
                <% if (item.size) { %>Size: <%= item.size %><% } %>
              </p>
              <p class="cart-card-label">Quantity</p>
              <div class="qty-control">
                <form method="POST" action="/cart/update" class="d-inline">
                  <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
                  <input type="hidden" name="quantity" value="<%= item.quantity - 1 %>">
                  <button class="qty-btn" type="submit">−</button>
                </form>
                <span class="qty-value"><%= item.quantity %></span>
                <form method="POST" action="/cart/update" class="d-inline">
                  <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
                  <input type="hidden" name="quantity" value="<%= item.quantity + 1 %>">
                  <button class="qty-btn" type="submit">+</button>
                </form>
              </div>
              <p class="cart-card-label">Price</p>
              <p class="cart-card-value">฿<%= Number(item.price).toLocaleString() %></p>
              <p class="cart-card-label">Total</p>
              <p class="cart-card-value">฿<%= (Number(item.price) * item.quantity).toLocaleString() %></p>
            </div>
            <form method="POST" action="/cart/remove" class="cart-card-delete-form">
              <input type="hidden" name="cart_item_id" value="<%= item.cart_item_id %>">
              <button class="cart-card-delete" type="submit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <polyline points="3 6 5 6 21 6"/>
                  <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                  <path d="M10 11v6M14 11v6"/>
                  <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/>
                </svg>
              </button>
            </form>
          </div>
          <% }) %>
        </div>

        <div class="cart-footer"> <div class="cart-total">Total: ฿<%= Number(total).toLocaleString() %></div>
          <button class="btn-checkout" id="checkoutBtn">CHECKOUT</button>
        </div>

        <div class="checkout-thankyou" id="checkoutThankyou" style="display:none;">
          <p>Thank you for your order!</p>
          <button class="btn-close-thankyou" id="closeThankyou">Close</button>
        </div>

      <% } %>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/navbar.js"></script>
  <script src="/js/cart.js"></script>
</body>
</html>