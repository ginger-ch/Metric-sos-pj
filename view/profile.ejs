<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Profile — Girlette</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/profile.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <main class="profile-main">
    <div class="container-fluid px-4 px-lg-5">

      <!-- header -->
      <div class="profile-top d-flex justify-content-between align-items-start">
        <div>
          <h1 class="profile-welcome">Welcome, <%= user.username %></h1>
          <p class="profile-date"><%= dateStr %></p>
        </div>
        <button class="profile-notif-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          </svg>
        </button>
      </div>

      <div class="profile-card">

        <div class="profile-banner"></div>

        <!-- pic + info -->
        <div class="profile-identity d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-3">
            <div class="profile-avatar-wrapper">
              <img
                src="<%= user.profile_image || 'https://i.pravatar.cc/150?u=' + user.user_id %>"
                alt="avatar"
                class="profile-avatar"
                id="avatarPreview">

              <% if (editMode) { %>
              <label for="avatarInput" class="avatar-edit-overlay" title="Change photo">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                  <circle cx="12" cy="13" r="4"/>
                </svg>
              </label>
              <form id="avatarForm" action="/profile/avatar" method="POST" enctype="multipart/form-data">
                <input type="file" id="avatarInput" name="avatar"
                       accept="image/jpeg,image/png,image/webp" style="display:none">
              </form>
              <% } %>
            </div>
            <div>
              <p class="profile-name"><%= user.full_name || user.username %></p>
              <p class="profile-email"><%= user.email %></p>
            </div>
          </div>
          <% if (!editMode) { %>
            <a href="/profile?edit=1" class="profile-edit-btn">Edit</a>
          <% } %>
        </div>

        <form action="/profile/edit" method="POST" class="profile-form">
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="profile-error"><%= error %></div>
            <% } %>
          <div class="row g-4 mt-2">

            <!-- full Name ,dob -->
            <div class="col-12 col-md-6">
              <label class="form-label-custom">Full Name</label>
              <input type="text" name="full_name" class="form-input-custom"
                value="<%= user.full_name || '' %>" <%= !editMode ? 'readonly' : '' %>>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label-custom">Date Of Birth</label>
              <input type="date" name="date_of_birth" class="form-input-custom"
                value="<%= user.date_of_birth ? user.date_of_birth.toISOString().split('T')[0] : '' %>"
                <%= !editMode ? 'readonly' : '' %>>
            </div>

            <!-- username, p, e , a -->
            <div class="col-12 col-md-6 d-flex flex-column gap-4">
              <div>
                <label class="form-label-custom">Username</label>
                <input type="text" name="username" class="form-input-custom"
                  value="<%= user.username %>" <%= !editMode ? 'readonly' : '' %>>
              </div>
              <div>
                <label class="form-label-custom">Phone</label>
                <div class="phone-wrapper">
                  <div class="phone-flag">
                    <img src="https://flagcdn.com/w20/th.png" alt="TH">
                  </div>
                  <input type="text" name="phone" class="form-input-custom phone-input"
                    value="<%= user.phone || '' %>" <%= !editMode ? 'readonly' : '' %>>
                </div>
              </div>
              <div>
                <label class="form-label-custom">Email</label>
                <input type="email" name="email" class="form-input-custom"
                  value="<%= user.email %>" <%= !editMode ? 'readonly' : '' %>>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label-custom">Address</label>
              <textarea name="address" class="form-input-custom form-textarea-tall"
                <%= !editMode ? 'readonly' : '' %>><%= user.address || '' %></textarea>
            </div>

          </div>

          <% if (editMode) { %>
          <div class="profile-form-actions">
            <button type="submit" class="btn-save">SAVE</button>
            <a href="/profile" class="btn-cancel">CANCEL</a>
          </div>
          <% } %>

        </form>
      </div>

    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/navbar.js"></script>
  <script>
    const avatarInput = document.getElementById('avatarInput');
    const avatarPreview = document.getElementById('avatarPreview');
    const avatarForm = document.getElementById('avatarForm');

    if (avatarInput) {
      avatarInput.addEventListener('change', () => {
        const file = avatarInput.files[0];
        if (!file) return;
        avatarPreview.src = URL.createObjectURL(file);
        avatarForm.submit();
      });
    }
  </script>
</body>
</html>