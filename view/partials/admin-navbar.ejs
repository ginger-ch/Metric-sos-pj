<div class="adm-overlay" id="adm-overlay"></div>
<aside class="adm-sidebar" id="adm-sidebar">
  <div class="adm-sidebar__brand">Girlette 🪡</div>
  <ul class="adm-sidebar__links">
    <li><a href="/admin/dashboard">🏠</a></li>
    <li><a href="/admin/sales-history">Sales History</a></li>
    <li><a href="/admin/orders">Orders</a></li>
    <li><a href="/admin/products">Product</a></li>
    <li><a href="/admin/categories">Categories</a></li>
  </ul>
</aside>

<script>
  const _admMenuBtn = document.getElementById('adm-menu-toggle');
  const _admSidebar = document.getElementById('adm-sidebar');
  const _admOverlay = document.getElementById('adm-overlay');
  function _admToggle() {
    _admSidebar.classList.toggle('adm-sidebar--open');
    _admOverlay.classList.toggle('adm-overlay--show');
  }
  _admMenuBtn.addEventListener('click', _admToggle);
  _admOverlay.addEventListener('click', _admToggle);
</script>