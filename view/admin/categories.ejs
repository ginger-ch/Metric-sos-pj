<%- include('../partials/admin-navbar') %>

<main class="admin-category-container">
  <div class="page-header">
    <div>
      <h1>Categories</h1>
      <p>Manage your categories</p>
    </div>

    <div class="filter-search-bar">
      <form method="GET" action="/admin/categories" id="filterForm">
        <select name="filter" onchange="this.form.submit()">
          <option value="">All Categories</option>
          <option value="show"  <%= selectedFilter === 'show'   ? 'selected' : '' %>>Show</option>
          <option value="hidden"<%= selectedFilter === 'hidden' ? 'selected' : '' %>>Hidden</option>
        </select>
      </form>

      <form method="GET" action="/admin/categories" id="searchForm">
        <input type="hidden" name="filter" value="<%= selectedFilter %>">
        <div class="search-input-wrap">
          <input
            type="text"
            name="search"
            placeholder="Search category name"
            value="<%= search %>"
            oninput="debounceSearch(this)"
          />
          <span class="search-icon">🔍</span>
        </div>
      </form>

      <button class="btn-add" onclick="openModal('newCategoryModal')">+</button>
    </div>
  </div>

  <!-- ตารางจะเพิ่มตรงนี้ -->

</main>

<!-- ✅ modal อยู่นอก main -->
<div id="newCategoryModal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <h2>New Category</h2>
    <form method="POST" action="/admin/categories">
      <label>Category name</label>
      <input type="text" name="category_name" required placeholder="Category name">

      <label>Visibility</label>
      <select name="visibility">
        <option value="show">show</option>
        <option value="hidden">hidden</option>
      </select>

      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeModal('newCategoryModal')">CANCEL</button>
        <button type="submit" class="btn-confirm">CONFIRM</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/admin-category.js"></script>