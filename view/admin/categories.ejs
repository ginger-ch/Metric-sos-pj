<link rel="stylesheet" href="/css/admin-category.css">
<%- include('../partials/admin-navbar') %>

<main class="admin-category-container">
  <div class="page-header">
    <div>
      <h1>Categories</h1>
      <p>Manage your categories</p>
    </div>

    <div class="filter-search-bar">
      <form method="GET" action="/admin/categories" id="filterForm">
        <select name="filter" onchange="this.form.submit()">
          <option value="">All Categories</option>
          <option value="show"  <%= selectedFilter === 'show'   ? 'selected' : '' %>>Show</option>
          <option value="hidden"<%= selectedFilter === 'hidden' ? 'selected' : '' %>>Hidden</option>
        </select>
      </form>

      <form method="GET" action="/admin/categories" id="searchForm">
        <input type="hidden" name="filter" value="<%= selectedFilter %>">
        <div class="search-input-wrap">
          <input
            type="text"
            name="search"
            placeholder="Search category name"
            value="<%= search %>"
            oninput="debounceSearch(this)"
          />
          <span class="search-icon">🔍</span>
        </div>
      </form>

      <button class="btn-add" onclick="openModal('newCategoryModal')">+</button>
    </div>
  </div>

  <table class="category-table">
    <thead>
      <tr>
        <th>CATEGORY NAME</th>
        <th>PRODUCT</th>
        <th>VISIBILITY</th>
        <th>ACTION</th>
      </tr>
    </thead>
    <tbody>
      <% categories.forEach(cat => { %>
      <tr>
        <td>#<%= cat.category_name.toLowerCase() %></td>
        <td><%= cat.product_count %></td>
        <td><%= cat.visibility %></td>
        <td class="action-btns">
          <% if (cat.visibility === 'show') { %>
            <button class="btn-hide" onclick="toggleVisibility(<%= cat.category_id %>, 'hidden')">HIDE</button>
          <% } else { %>
            <button class="btn-show" onclick="toggleVisibility(<%= cat.category_id %>, 'show')">SHOW</button>
          <% } %>
          <button class="btn-edit" onclick="openEditModal(<%= cat.category_id %>, '<%= cat.category_name %>', '<%= cat.visibility %>')">EDIT</button>
          <button class="btn-delete" onclick="deleteCategory(<%= cat.category_id %>)">DELETE</button>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="category-accordion">
    <% categories.forEach(cat => { %>
    <div class="accordion-item" onclick="toggleAccordion(this)">
      <div class="accordion-header">
        <span>#<%= cat.category_name.toLowerCase() %></span>
        <span class="accordion-arrow">&#8743;</span>
      </div>
      <div class="accordion-body">
        <p>Product : <%= cat.product_count %></p>
        <p>Visibility : <%= cat.visibility %></p>
        <div class="action-btns">
          <% if (cat.visibility === 'show') { %>
            <button class="btn-hide" onclick="event.stopPropagation(); toggleVisibility(<%= cat.category_id %>, 'hidden')">hide</button>
          <% } else { %>
            <button class="btn-show" onclick="event.stopPropagation(); toggleVisibility(<%= cat.category_id %>, 'show')">show</button>
          <% } %>
          <button class="btn-edit" onclick="event.stopPropagation(); openEditModal(<%= cat.category_id %>, '<%= cat.category_name %>', '<%= cat.visibility %>')">EDIT</button>
          <button class="btn-delete" onclick="event.stopPropagation(); deleteCategory(<%= cat.category_id %>)">DELETE</button>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

</main>

<div id="newCategoryModal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <h2>New Category</h2>
    <form method="POST" action="/admin/categories">
      <label>Category name</label>
      <input type="text" name="category_name" required placeholder="Category name">
      <label>Visibility</label>
      <select name="visibility">
        <option value="show">show</option>
        <option value="hidden">hidden</option>
      </select>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeModal('newCategoryModal')">CANCEL</button>
        <button type="submit" class="btn-confirm">CONFIRM</button>
      </div>
    </form>
  </div>
</div>

<div id="editCategoryModal" class="modal-overlay" style="display:none">
  <div class="modal-box">
    <h2>Edit Category</h2>
    <form id="editCategoryForm">
      <label>Category name</label>
      <input type="text" id="editCategoryName" name="category_name" required>
      <label>Visibility</label>
      <select id="editVisibility" name="visibility">
        <option value="show">Show</option>
        <option value="hidden">Hidden</option>
      </select>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" onclick="closeModal('editCategoryModal')">CANCEL</button>
        <button type="button" class="btn-confirm" onclick="submitEdit()">CONFIRM</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/admin-category.js"></script>
