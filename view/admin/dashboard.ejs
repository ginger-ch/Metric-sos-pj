<%- include('../layouts/header', { extraCss: '/css/admin-dashboard.css' }) %>
<%- include('../partials/admin-navbar') %>

<div class="adm-layout">

  <!-- ===== LEFT ===== -->
  <aside class="adm-left">

    <div class="adm-profile">
      <img
        src="<%= admin.profileImage || '/image/default-avatar.png' %>"
        alt="<%= admin.name %>"
        class="adm-profile__avatar"
      />
      <div>
        <h2 class="adm-profile__name"><%= admin.name %></h2>
        <span class="adm-profile__role">Admin</span>
      </div>
    </div>

    <section class="adm-section">
      <p class="adm-section-title">Earning</p>
      <p class="adm-label">Total Month Income</p>
      <p class="adm-stat"><%= earnings.totalMonth %></p>
      <p class="adm-label">Total Week Income</p>
      <p class="adm-stat adm-stat--sm"><%= earnings.totalWeek %></p>
    </section>

    <section class="adm-section">
      <p class="adm-section-title">Item sold</p>
      <ul class="adm-item-list">
        <% itemSold.forEach(item => { %>
        <li>
          <span><%= item.name %></span>
          <span><%= item.qty %></span>
        </li>
        <% }) %>
      </ul>
    </section>

    <section class="adm-section">
      <p class="adm-section-title">Popular items</p>
      <% popularItems.forEach(item => { %>
      <div class="adm-popular-item">
        <span class="adm-popular-rank"><%= item.rank %></span>
        <span><%= item.name %> : <%= item.orders %> orders</span>
      </div>
      <% }) %>
    </section>

  </aside>

  <!-- ===== CENTER ===== -->
  <main class="adm-center">

    <section class="adm-section">
      <p class="adm-section-title">Product & Categories</p>
      <div class="adm-cat-list">
        <% categories.forEach((cat, i) => { %>
        <div class="adm-cat-item" data-index="<%= i %>">
          <span class="adm-cat-drag">&#9776;</span>
          <span class="adm-cat-name"><%= cat.name %></span>
          <span class="adm-cat-arrow" id="arrow-<%= i %>">&#8964;</span>
        </div>
        <div class="adm-cat-products" id="cat-products-<%= i %>">
          <% cat.products.forEach(p => { %>
          <div class="adm-cat-product-item"><%= p %></div>
          <% }) %>
        </div>
        <% }) %>
      </div>
      <div class="adm-totals">
        <div>
          <p class="adm-label">Total category</p>
          <p class="adm-stat"><%= totalCategory %></p>
        </div>
        <div>
          <p class="adm-label">Total product</p>
          <p class="adm-stat"><%= totalProduct %></p>
        </div>
      </div>
    </section>

    <section class="adm-section">
      <p class="adm-section-title">Recent Orders</p>
      <table class="adm-table">
        <thead>
          <tr>
            <th>Order number</th>
            <th>Order date</th>
            <th>Customer acc</th>
          </tr>
        </thead>
        <tbody>
          <% recentOrders.forEach(order => { %>
          <tr>
            <td>#<%= order.number %></td>
            <td><%= order.date %></td>
            <td><%= order.customer %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </section>

  </main>

  <!-- ===== RIGHT ===== -->
  <aside class="adm-right">
    <% if (notifications.length > 0) { %>
    <section class="adm-notif-panel">
      <% notifications.forEach((notif, i) => { %>
      <div class="adm-notif-card" id="notif-<%= i %>">
        <div class="adm-notif-content">
          <span class="adm-notif-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="12" y1="8" x2="12" y2="12"/>
              <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
          </span>
          <div>
            <p class="adm-notif-title"><%= notif.message %></p>
            <p class="adm-notif-body"><%= notif.body %></p>
          </div>
        </div>
        <button class="adm-notif-close" data-index="<%= i %>">&times;</button>
      </div>
      <% }) %>
    </section>
    <% } %>
  </aside>

</div>

<script src="/js/notifications.js"></script>