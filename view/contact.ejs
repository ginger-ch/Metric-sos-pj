<%# views/contact.ejs %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact — Girlette</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/contact.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>
<body>

  <%- include('partials/navbar') %>

  <main class="contact-page">

    <!-- ── MAP + ADDRESS (side by side) ─────────────────── -->
    <div class="map-row">
      <section class="map-section">
        <iframe
          class="map-embed"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps/embed/v1/place?key=AIzaSyAXQtcWdqDjFHRoAiv2HZJlkEfIFI-0mjI&q=Chiang+Mai+University,239+Huay+Kaew+Road+Suthep+Muang+Chiang+Mai+50200"
          title="Girlette store location">
        </iframe>
      </section>

      <div class="address-panel">
        <span class="block-label">Visit Us</span>
        <address class="contact-address">
          239 Huay Kaew Road, Suthep,<br>
          Mueang Chiang Mai, Chiang Mai, 50200
        </address>
      </div>
    </div>

    <!-- ── INFO + LINKS + NEWSLETTER ─────────────────────── -->
    <section class="info-section">

      <!-- Contact details -->
      <div class="contact-block">
        <span class="block-label">Contact Us</span>
        <p class="contact-phone">+66 82-146-1435</p>
        <a href="mailto:hello@girlette.com" class="contact-email">Email Us</a>
        <p class="contact-hours">Mon – Fri &nbsp;9am – 3pm (UTC+7)</p>
      </div>

      <!-- Footer links -->
      <div class="links-row">
        <div class="links-col">
          <span class="block-label">Company</span>
          <ul>
            <li><a href="#">About Us</a></li>
            <li><a href="#">Sustainability</a></li>
            <li><a href="#">Discover Revive</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Privacy Policy</a></li>
            <li><a href="#">Terms</a></li>
          </ul>
        </div>
        <div class="links-col">
          <span class="block-label">Customers</span>
          <ul>
            <li><a href="#">Start a Return</a></li>
            <li><a href="#">Return Policy</a></li>
            <li><a href="#">FAQ</a></li>
            <li><a href="#">Catalogs &amp; Mailers</a></li>
            <li><a href="#">About Group Gifting</a></li>
          </ul>
        </div>
      </div>

      <!-- Newsletter -->
      <div class="newsletter-block">
        <p class="newsletter-title">Get the latest from us</p>
        <div class="newsletter-form">
          <form id="subscribeForm">
            <input
              type="email"
              name="email"
              placeholder="Enter your email address"
              class="newsletter-input"
              required
            />
            <p class="newsletter-legal">
              By signing up, you agree to our
              <a href="#">Privacy Policy</a> and <a href="#">Terms of Service</a>.
            </p>
            <button class="newsletter-btn" type="submit"><span>Subscribe</span></button>
          </form>
        </div>
      </div>

    </section>

  </main>

  <!-- ── SUCCESS MODAL ─────────────────────────────────────── -->
  <div id="successModal" class="modal hidden">
    <div class="modal-content">
      <p>Thank you for subscribing!</p>
      <button onclick="closeModal()">Close</button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/navbar.js"></script>
  <script src="/js/contact.js"></script>

</body>
</html>
