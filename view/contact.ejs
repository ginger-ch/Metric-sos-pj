<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact — Girlette</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/css/navbar.css" />
  <link rel="stylesheet" href="/css/contact.css" />
  <link rel="stylesheet" href="/css/footer.css" />
</head>
<body>


  <%- include('partials/navbar') %>

  <main class="contact-page">

    <!-- ── MAP SECTION ── -->
    <section class="map-section">
  <iframe
    class="map-embed"
    width="100%"
    height="450"
    style="border:0"
    loading="lazy"
    allowfullscreen
    referrerpolicy="no-referrer-when-downgrade"
    src="https://www.google.com/maps/embed/v1/place?key=AIzaSyAXQtcWdqDjFHRoAiv2HZJlkEfIFI-0mjI&q=Chiang+Mai+University,239+Huay+Kaew+Road+Suthep+Muang+Chiang+Mai+50200"
    title="Girlette store location">
  </iframe>
</section>

<section class="info-section">
  <div class="contact-block">
    <p class="block-label">VISIT US</p>
    <address class="contact-address">
      239 Huay Kaew Road, Suthep,<br>
      Mueang Chiang Mai, Chiang Mai, 50200
    </address>
    
    <p class="block-label" style="margin-top: 20px;">CONTACT US</p>
    <p class="contact-phone">+66 82-146-1435</p>
    <a href="mailto:hello@girlette.com" class="contact-email">Email Us</a>
    <p class="contact-hours">Mon-Fri 9am-3pm (UTC+7)</p>
  </div>
  </section>

    <!-- ── CONTACT INFO + NEWSLETTER ── -->
    <section class="info-section">

      <div class="contact-block">
        <p class="block-label">CONTACT US</p>
        <p class="contact-phone">+66 82-146-1435</p>
        <a href="mailto:hello@girlette.com" class="contact-email">Email Us</a>
        <p class="contact-hours">Mon-Fri 9am-3pm (UTC+7)</p>
      </div>

      <div class="links-row">

        <div class="links-col">
          <p class="block-label">COMPANY</p>
          <ul>
            <li><a href="#">About Us</a></li>
            <li><a href="#">Sustainability</a></li>
            <li><a href="#">Discover Revive</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Privacy Policy</a></li>
            <li><a href="#">Terms</a></li>
          </ul>
        </div>

        <div class="links-col">
          <p class="block-label">CUSTOMERS</p>
          <ul>
            <li><a href="#">Start a Return</a></li>
            <li><a href="#">Return Policy</a></li>
            <li><a href="#">FAQ</a></li>
            <li><a href="#">Catalogs and Mailers</a></li>
            <li><a href="#">About Group Gifting</a></li>
          </ul>
        </div>

      </div>

      <!-- Newsletter -->
      <div class="newsletter-block">
        <p class="newsletter-title">Get the latest new from us</p>
        <div class="newsletter-form">
            <form id="subscribeForm">
          <input 
            type="email" 
            name="email"
            placeholder="Enter your email address" 
            class="newsletter-input" 
            required
            />
          <p class="newsletter-legal">
            By signing up, you agree to our
            <a href="#">Privacy Policy</a> and <a href="#">Terms of Service</a>.
          </p>
          <button class="newsletter-btn" type="submit">Subscribe</button>
          </form>
        </div>

        
      </div>
      <!-- MODAL -->
        <div id="successModal" class="modal hidden">
        <div class="modal-content">
            <p>Thank you for subscribing!</p>
            <button onclick="closeModal()">Close</button>
        </div>
        </div>

    </section>

  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/navbar.js"></script>
  <script src="/js/contact.js"></script>

</body>
</html>
